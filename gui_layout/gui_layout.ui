               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;when enabled, only shows tasks with matching task names.&lt;/p&gt;&lt;p&gt;task filter text can contain more than one task name, separated by space&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>

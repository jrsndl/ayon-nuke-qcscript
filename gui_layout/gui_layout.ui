    border-color: #1e1e1e;

    border-style: solid;

    border-radius: 4;

    padding: 3px;

    font-size: 16px;

    padding-left: 5px;

    padding-right: 5px;

	outline: 0;

}



QPushButton:pressed

{

    background-color: QLinearGradient( x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #2d2d2d, stop: 0.1 #2b2b2b, stop: 0.5 #292929, stop: 0.9 #282828, stop: 1 #252525);

}




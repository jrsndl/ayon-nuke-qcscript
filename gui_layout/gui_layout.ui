    background-color: #323232;

    border: 1px solid #b1b1b1;

    width: 9px;

    height: 9px;

}



QCheckBox::indicator:checked

{


    color: #ffaa00;

    background-color:#ffaa00;

}



QRadioButton::indicator:disabled

{

    border: 1px solid #444;

}



QCheckBox::indicator:disabled

